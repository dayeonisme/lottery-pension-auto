{
  "name": "quarterly report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 1 1,4,7,10 *"
            }
          ]
        }
      },
      "id": "trigger-quarterly",
      "name": "Schedule Trigger (quarter start 10:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "command": "export $(sudo cat /etc/n8n/env | xargs) && timeout 300 /home/ubuntu/lottery_auto/.venv/bin/python3 /home/ubuntu/lottery_auto/scripts/monthly_report.py --quarterly",
        "executeOnce": true
      },
      "id": "exec-quarterly",
      "name": "Execute Command",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger (quarter start 10:00)": {
      "main": [
        [
          {
            "node": "Execute Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true
  },
  "staticData": null,
  "tags": [],
  "active": false
}
